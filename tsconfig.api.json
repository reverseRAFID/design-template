{
  "compilerOptions": {
    "target": "ES2022",
    // The serverless runtime is Node with the platform's fetch/Request/Response,
    // so this one needs both the web lib and node types — unlike the app, which
    // has no Node, and unlike scripts, which have no DOM.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["api"]
}
